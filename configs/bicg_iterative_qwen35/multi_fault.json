{
  "experiment_id": "bicg_iterative_qwen35_multi_fault",
  "benchmark_source": "benchmarks/bicg/faults/multi_fault_feedback",
  "repair_mode": "iterative_direct_api",
  "provider": "siliconflow",
  "model": "Qwen/Qwen3.5-122B-A10B",
  "temperature": 0.0,
  "max_output_tokens": 1024,
  "api_timeout_seconds": 180,
  "max_iterations": 3,
  "editable_files": ["src/bicg.cpp"],
  "protected_files": ["src/bicg.h", "testbench/bicg_test.cpp", "task.cfg"],
  "context_files": ["src/bicg.h", "testbench/bicg_test.cpp", "task.cfg"],
  "host_validation": {
    "command": ["g++", "-std=c++17", "-Isrc", "src/bicg.cpp", "testbench/bicg_test.cpp", "-o", "host_test"],
    "run_command": ["./host_test"]
  },
  "independent_validation": {
    "enabled": true,
    "command": ["bash", "-lc", "python3 agent/run_repair.py '{workspace}' | tee /dev/stderr | grep -q 'Original result: PASSED'"]
  }
}
