{
  "experiment_id": "bicg_api_qwen35_syntax",
  "benchmark_source": "benchmarks/bicg/faults/syntax_missing_semicolon",
  "repair_mode": "direct_api",
  "provider": "siliconflow",
  "model": "Qwen/Qwen3.5-122B-A10B",
  "temperature": 0.0,
  "max_output_tokens": 1024,
  "api_timeout_seconds": 180,
  "editable_files": [
    "src/bicg.cpp"
  ],
  "protected_files": [
    "src/bicg.h",
    "testbench/bicg_test.cpp",
    "task.cfg"
  ],
  "context_files": [
    "src/bicg.h",
    "testbench/bicg_test.cpp",
    "task.cfg"
  ],
  "host_validation": {
    "command": [
      "g++",
      "-std=c++17",
      "-Isrc",
      "src/bicg.cpp",
      "testbench/bicg_test.cpp",
      "-o",
      "host_test"
    ],
    "run_command": [
      "./host_test"
    ]
  },
  "independent_validation": {
    "enabled": true,
    "command": [
      "bash",
      "-lc",
      "python3 agent/run_repair.py '{workspace}' | tee /dev/stderr | grep -q 'Original result: PASSED'"
    ]
  }
}
