{
  "experiment_id": "vector_add_structured_functional",
  "benchmark_source": "benchmarks/vector_add/faults/functional_subtraction",
  "repair_mode": "structured_feedback",
  "model": "gpt-5.5",
  "agent_timeout_seconds": 180,
  "editable_files": ["src/vector_add.cpp"],
  "protected_files": ["src/vector_add.h", "testbench/vector_add_test.cpp", "task.cfg"],
  "host_validation": {
    "command": ["g++", "-std=c++17", "-Isrc", "src/vector_add.cpp", "testbench/vector_add_test.cpp", "-o", "host_test"],
    "run_command": ["./host_test"]
  },
  "independent_validation": {
    "enabled": true,
    "command": ["bash", "-lc", "python3 agent/run_repair.py '{workspace}' | tee /dev/stderr | grep -q 'Original result: PASSED'"]
  }
}
